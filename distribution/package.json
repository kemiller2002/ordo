{
  "name": "@echelon-foundry/sde",
  "version": "1.3.0",
  "description": "Echelon Foundry State-Directed Engineering repository initialization, verification, diagnostics, and upgrade tooling.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kemiller2002/ordo.git",
    "directory": "distribution"
  },
  "homepage": "https://github.com/kemiller2002/ordo#readme",
  "bugs": {
    "url": "https://github.com/kemiller2002/ordo/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "sde": "bin/sde.js"
  },
  "files": [
    "bin",
    "dist",
    "runtimes",
    "DISTRIBUTION-MAP.json",
    "README.md"
  ],
  "keywords": [
    "echelon-foundry",
    "sde",
    "state-directed-engineering",
    "repository-tooling",
    "cli",
    "initialization",
    "verification",
    "migration",
    "engineering"
  ],
  "scripts": {
    "build": "npm run build:payload && npm run build:runtimes",
    "build:payload": "dotnet run --project ../src/Sde.PackageBuilder/Sde.PackageBuilder.fsproj -c Release --nologo -v quiet",
    "build:runtimes": "node scripts/publish-runtimes.mjs",
    "pretest": "npm run build:payload",
    "test": "dotnet test ../tests/Sde.Core.Tests/Sde.Core.Tests.fsproj --nologo",
    "test:package": "node scripts/test-package.mjs"
  },
  "dependencies": {},
  "devDependencies": {}
}
