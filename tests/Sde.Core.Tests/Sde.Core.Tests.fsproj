<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>Sde.Core.Tests</AssemblyName>
    <RootNamespace>Sde.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <GenerateProgramFile>true</GenerateProgramFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Fixtures.fs" />
    <Compile Include="ContractTests.fs" />
    <Compile Include="LifecycleTests.fs" />
    <Compile Include="PackageBuildTests.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Sde.Core/Sde.Core.fsproj" />
    <!--
      The CLI is referenced so that argument parsing, help text, rendering and
      exit codes are covered by the same suite. Driving Program.run directly
      keeps those tests fast and lets them assert on stdout and stderr
      separately without spawning a process.
    -->
    <ProjectReference Include="../../src/Sde.Cli/Sde.Cli.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

</Project>
