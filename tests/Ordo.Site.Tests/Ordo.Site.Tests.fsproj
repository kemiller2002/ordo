<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>Ordo.Site.Tests</AssemblyName>
    <RootNamespace>Ordo.Site.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <GenerateProgramFile>true</GenerateProgramFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Fixtures.fs" />
    <Compile Include="ManifestTests.fs" />
    <Compile Include="ContentTests.fs" />
    <Compile Include="ValidateTests.fs" />
    <Compile Include="SiteTests.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Ordo.Site/Ordo.Site.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

</Project>
