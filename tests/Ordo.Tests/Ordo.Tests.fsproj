<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>Ordo.Tests</AssemblyName>
    <RootNamespace>Ordo.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <GenerateProgramFile>true</GenerateProgramFile>
  </PropertyGroup>

  <!--
    One suite over all three production projects. The alternative — a test
    project per production project — would duplicate the fixture domain and
    the fake provider three times, and the architecture tests need to load
    all three assemblies at once anyway.
  -->
  <ItemGroup>
    <Compile Include="Fixtures.fs" />
    <Compile Include="CoreTests.fs" />
    <Compile Include="DecisionTests.fs" />
    <Compile Include="SliceTests.fs" />
    <Compile Include="ReplayTests.fs" />
    <Compile Include="WireTests.fs" />
    <Compile Include="AdapterTests.fs" />
    <Compile Include="LiveAdapterTests.fs" />
    <Compile Include="ArchitectureTests.fs" />
    <Compile Include="InvariantTests.fs" />
    <Compile Include="ExecutionGovernanceTests.fs" />
    <Compile Include="BoundaryAmplificationTests.fs" />
    <Compile Include="ExecutionContractTests.fs" />
    <Compile Include="ConstructionIrTests.fs" />
    <Compile Include="ConstructionIrWireTests.fs" />
    <Compile Include="ConstructionIrFixtureTests.fs" />
    <Compile Include="FsiProbe.fs" />
    <Compile Include="ConstructionPlanTests.fs" />
    <Compile Include="ConstructionPlanAdversarialTests.fs" />
    <Compile Include="ConstructionClassificationTests.fs" />
    <Compile Include="ConstructionCoverageTests.fs" />
    <Compile Include="ConstructionVocabulary4Tests.fs" />
    <Compile Include="ConstructionConflictResolutionTests.fs" />
    <Compile Include="ConstructionDecisionsV3Tests.fs" />
    <Compile Include="ConstructionVocabulary5Tests.fs" />
    <Compile Include="ConstructionVocabulary6Tests.fs" />
    <Compile Include="ConstructionDecisionsV4Tests.fs" />
    <Compile Include="ConstructionPlanConsensusTests.fs" />
    <Compile Include="ConstructionDefaultPlanTests.fs" />
    <Compile Include="ConstructionLedgerTests.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Ordo.Core/Ordo.Core.fsproj" />
    <ProjectReference Include="../../src/Ordo.Decisions/Ordo.Decisions.fsproj" />
    <ProjectReference Include="../../src/Ordo.Providers.Anthropic/Ordo.Providers.Anthropic.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

</Project>
