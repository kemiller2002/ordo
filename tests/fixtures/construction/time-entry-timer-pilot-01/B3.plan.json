          "IFC-TIMER-PORTS"
        ]
      }
    },
    {
      "op": "declareUnresolved",
      "subject": "Completion rounding",
      "question": "Stop rounds elapsed seconds (sum of closed segments, paused time excluded) to the nearest whole minute. The requirement does not state how an exact half minute (30, 90, ... seconds) rounds. Handwritten Completion.fs rounds halves up (away from zero); confirm or decide otherwise.",
      "trace": {
        "requirementKeys": [
          "kemiller2002/time-entry-state-machine/docs/architecture/business-activity-ledger-state-model.md#L131-L144",
