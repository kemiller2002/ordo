    {
      "op": "declareUnresolved",
      "subject": "Stop under thirty seconds",
      "question": "The source requirement for a stop after less than thirty seconds of running is recorded in ECIR as CONFLICT-TIMER-SHORT-STOP and is outside this cohort: the F# code rejects it (TIMER_TOO_SHORT, timer stays active) while the state model returns to NoTimer with nothing recorded. This plan keeps Stop legal from Running and Paused unconditionally (no guard) and leaves whether a too-short Stop is a refusal or a no-record transition to a decision.",
      "trace": {
        "requirementKeys": [
          "kemiller2002/time-entry-state-machine/docs/architecture/business-activity-ledger-state-model.md#L131-L144"
        ],
        "nodeIds": [
          "IFC-TIMER-PORTS"
        ]
      }
    },
    {
      "op": "declareUnresolved",
      "subject": "Stop completion rounding",
      "question": "Stop rounds elapsed seconds to the nearest whole minute; the source does not say how an exact half minute (n minutes 30 seconds) rounds. Handwritten completion rounds half away from zero (up). Confirm.",
      "trace": {
        "requirementKeys": [
          "kemiller2002/time-entry-state-machine/docs/architecture/business-activity-ledger-state-model.md#L131-L144"
        ],
        "nodeIds": [
