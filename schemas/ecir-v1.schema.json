{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://echelonfoundry.dev/schemas/ecir-v1.schema.json",
  "title": "Echelon Construction IR v1",
  "description": "Structural validity only. Exact independent intake equality, reciprocity, readiness, and authorization are enforced by Ordo ConstructionIr.validate / validateCohort and external gates.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "sourceManifestDigest",
    "requirements",
    "nodes"
  ],
  "properties": {
    "schemaVersion": {
      "const": "ecir/1"
    },
    "sourceManifestDigest": {
      "$ref": "#/$defs/digest"
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/requirement"
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/node"
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "id": {
      "$ref": "#/$defs/nonEmptyString",
      "maxLength": 200
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "originalId",
        "document",
        "location",
        "revision",
        "contentDigest"
      ],
      "properties": {
        "key": {
          "$ref": "#/$defs/id"
        },
        "originalId": {
          "$ref": "#/$defs/id"
        },
        "document": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "location": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "revision": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "contentDigest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "sourceManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "digest",
        "requirements"
      ],
      "properties": {
        "digest": {
          "$ref": "#/$defs/digest"
        },
        "requirements": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/source"
          }
        }
      }
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "disposition",
        "nodeIds"
      ],
      "properties": {
        "source": {
          "$ref": "#/$defs/source"
        },
        "disposition": {
          "$ref": "#/$defs/disposition"
        },
        "nodeIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        }
      }
    },
    "disposition": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "modeled"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "reason"
          ],
          "properties": {
            "kind": {
              "const": "deferred"
            },
            "reason": {
              "$ref": "#/$defs/nonEmptyString"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "reason"
          ],
          "properties": {
            "kind": {
              "const": "unresolved"
            },
            "reason": {
              "$ref": "#/$defs/nonEmptyString"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "reason"
          ],
          "properties": {
            "kind": {
              "const": "rejected"
            },
            "reason": {
              "$ref": "#/$defs/nonEmptyString"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "reason",
            "targetKey"
          ],
          "properties": {
            "kind": {
              "const": "superseded"
            },
            "reason": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "targetKey": {
              "$ref": "#/$defs/id"
            }
          }
        }
      ]
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "requirementKeys",
        "dependsOn"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": [
            "decision",
            "contract",
            "invariant",
            "interface",
            "cohort",
            "verificationObligation",
            "conflict",
            "deferral",
            "engineeringRationale"
          ]
        },
        "requirementKeys": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "dependsOn": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "justification": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    }
  }
}
