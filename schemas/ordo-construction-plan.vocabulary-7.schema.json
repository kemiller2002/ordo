{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://echelonfoundry.dev/schemas/ordo-construction-plan.vocabulary-7.schema.json",
  "title": "Ordo construction plan v1 (vocabulary ordo.construction-vocabulary/7)",
  "description": "Structural validity only. Vocabulary 7 is vocabulary 6 with document persistence (CONSTRUCT-010 phase 2): at most one declareDocument stating idempotency (durable | session | unresolved) of save operation ids and onSaveConflict (refuse | escalate | unresolved); assignRefusalCode may also target saveConflict. A document together with transition effects or with declarePersistence, a code on saveConflict without onSaveConflict refuse, a code on staleRevision without a document or a refusing persistence, and duplicates are refused by Ordo Construction validation, not by this schema.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "vocabularyVersion",
    "binding",
    "operations"
  ],
  "properties": {
    "schemaVersion": {
      "const": "ordo.construction-plan/1"
    },
    "vocabularyVersion": {
      "const": "ordo.construction-vocabulary/7"
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceManifestDigest",
        "blueprintDigest",
        "cohortId",
        "decisionIds"
      ],
      "properties": {
        "sourceManifestDigest": {
          "$ref": "#/$defs/digest"
        },
        "blueprintDigest": {
          "$ref": "#/$defs/digest"
        },
        "cohortId": {
          "$ref": "#/$defs/id"
        },
        "decisionIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          }
        }
      }
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/operation"
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "name": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[A-Za-z][A-Za-z0-9]*([ _-][A-Za-z0-9]+)*$"
    },
    "trace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requirementKeys",
        "nodeIds"
      ],
      "properties": {
        "requirementKeys": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "nodeIds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/id"
          }
        }
      }
    },
    "predicate": {
      "enum": [
        "extension"
      ]
    },
    "operation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "name",
            "trace"
          ],
          "properties": {
            "op": {
              "const": "defineWorkflow"
            },
            "name": {
              "$ref": "#/$defs/name"
            },
            "trace": {
              "$ref": "#/$defs/trace"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "name",
            "role",
            "trace"
          ],
          "properties": {
            "op": {
              "const": "defineState"
            },
            "name": {
              "$ref": "#/$defs/name"
            },
            "role": {
              "enum": [
                "initial",
                "ordinary",
                "terminal"
              ]
            },
            "trace": {
              "$ref": "#/$defs/trace"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "command",
            "from",
            "to",
            "guards",
            "trace"
          ],
          "properties": {
            "op": {
              "const": "defineTransition"
            },
            "command": {
              "$ref": "#/$defs/name"
            },
            "from": {
              "$ref": "#/$defs/name"
            },
            "to": {
              "$ref": "#/$defs/name"
            },
            "guards": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name",
                  "predicate"
                ],
                "properties": {
                  "name": {
                    "$ref": "#/$defs/name"
                  },
                  "predicate": {
                    "$ref": "#/$defs/predicate"
                  }
                }
              }
            },
            "trace": {
              "$ref": "#/$defs/trace"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "name",
            "predicate",
            "holdsIn",
            "trace"
          ],
          "properties": {
            "op": {
              "const": "defineInvariant"
            },
            "name": {
              "$ref": "#/$defs/name"
            },
            "predicate": {
              "$ref": "#/$defs/predicate"
            },
            "holdsIn": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/name"
              }
            },
            "trace": {
              "$ref": "#/$defs/trace"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "port",
            "trace"
          ],
          "properties": {
            "op": {
              "const": "declarePort"
            },
            "port": {
              "const": "currentTime"
            },
            "trace": {
              "$ref": "#/$defs/trace"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "port",
            "command",
            "trace"
          ],
          "properties": {
            "op": {
              "const": "declarePort"
            },
            "port": {
              "const": "transitionEffect"
            },
            "command": {
              "$ref": "#/$defs/name"
            },
            "trace": {
              "$ref": "#/$defs/trace"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "command",
            "capability",
            "trace"
          ],
          "properties": {
            "op": {
              "const": "bindCapability"
            },
            "command": {
              "$ref": "#/$defs/name"
            },
            "capability": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "trace": {
              "$ref": "#/$defs/trace"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "subject",
            "question",
            "trace"
          ],
          "properties": {
            "op": {
              "const": "declareUnresolved"
            },
            "subject": {
              "$ref": "#/$defs/name"
            },
            "effect": {
              "$ref": "#/$defs/name"
            },
            "question": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "trace": {
              "$ref": "#/$defs/trace"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "unlisted",
            "trace"
          ],
          "properties": {
            "op": {
              "const": "declarePairRule"
            },
            "unlisted": {
              "enum": [
                "refused",
                "undecided"
              ]
            },
            "trace": {
              "$ref": "#/$defs/trace"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "command",
            "from",
            "trace"
          ],
          "properties": {
            "op": {
              "const": "defineRefusal"
            },
            "command": {
              "$ref": "#/$defs/name"
            },
            "from": {
              "$ref": "#/$defs/name"
            },
            "trace": {
              "$ref": "#/$defs/trace"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "command",
            "from",
            "question",
            "trace"
          ],
          "properties": {
            "op": {
              "const": "declareUndecidedTransition"
            },
            "command": {
              "$ref": "#/$defs/name"
            },
            "from": {
              "$ref": "#/$defs/name"
            },
            "question": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000,
              "pattern": "\\S"
            },
            "trace": {
              "$ref": "#/$defs/trace"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "extension",
            "decisionPoints",
            "trace"
          ],
          "properties": {
            "op": {
              "const": "declareExtensionInventory"
            },
            "extension": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind",
                    "name"
                  ],
                  "properties": {
                    "kind": {
                      "enum": [
                        "guard",
                        "invariant",
                        "effect"
                      ]
                    },
                    "name": {
                      "$ref": "#/$defs/name"
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind",
                    "from",
                    "command"
                  ],
                  "properties": {
                    "kind": {
                      "const": "selection"
                    },
                    "from": {
                      "$ref": "#/$defs/name"
                    },
                    "command": {
                      "$ref": "#/$defs/name"
                    }
                  }
                }
              ]
            },
            "decisionPoints": {
              "type": "array",
              "items": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "point",
                      "decided",
                      "trace"
                    ],
                    "properties": {
                      "point": {
                        "$ref": "#/$defs/name"
                      },
                      "decided": {
                        "const": true
                      },
                      "trace": {
                        "$ref": "#/$defs/trace"
                      }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "point",
                      "decided",
                      "question",
                      "trace"
                    ],
                    "properties": {
                      "point": {
                        "$ref": "#/$defs/name"
                      },
                      "decided": {
                        "const": false
                      },
                      "question": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 1000,
                        "pattern": "\\S"
                      },
                      "trace": {
                        "$ref": "#/$defs/trace"
                      }
                    }
                  }
                ]
              }
            },
            "trace": {
              "$ref": "#/$defs/trace"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "code",
            "trace"
          ],
          "properties": {
            "op": {
              "const": "defineRefusalCode"
            },
            "code": {
              "$ref": "#/$defs/name"
            },
            "trace": {
              "$ref": "#/$defs/trace"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "target",
            "code",
            "trace"
          ],
          "properties": {
            "op": {
              "const": "assignRefusalCode"
            },
            "target": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind",
                    "from",
                    "command"
                  ],
                  "properties": {
                    "kind": {
                      "const": "pair"
                    },
                    "from": {
                      "$ref": "#/$defs/name"
                    },
                    "command": {
                      "$ref": "#/$defs/name"
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind"
                  ],
                  "properties": {
                    "kind": {
                      "const": "unlisted"
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind",
                    "name"
                  ],
                  "properties": {
                    "kind": {
                      "const": "guard"
                    },
                    "name": {
                      "$ref": "#/$defs/name"
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind"
                  ],
                  "properties": {
                    "kind": {
                      "const": "notFound"
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind"
                  ],
                  "properties": {
                    "kind": {
                      "const": "staleRevision"
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind"
                  ],
                  "properties": {
                    "kind": {
                      "const": "saveConflict"
                    }
                  }
                }
              ]
            },
            "code": {
              "$ref": "#/$defs/name"
            },
            "trace": {
              "$ref": "#/$defs/trace"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "command",
            "from",
            "targets",
            "trace"
          ],
          "properties": {
            "op": {
              "const": "defineBranchingTransition"
            },
            "command": {
              "$ref": "#/$defs/name"
            },
            "from": {
              "$ref": "#/$defs/name"
            },
            "targets": {
              "type": "array",
              "minItems": 2,
              "items": {
                "$ref": "#/$defs/name"
              }
            },
            "trace": {
              "$ref": "#/$defs/trace"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "effect",
            "retries",
            "onFailed",
            "onUnknown",
            "trace"
          ],
          "properties": {
            "op": {
              "const": "declareEffectPolicy"
            },
            "effect": {
              "$ref": "#/$defs/name"
            },
            "retries": {
              "type": "integer",
              "minimum": 0,
              "maximum": 5
            },
            "onFailed": {
              "enum": [
                "remain",
                "proceed",
                "compensate",
                "escalate",
                "unresolved"
              ]
            },
            "onUnknown": {
              "enum": [
                "reconcile",
                "escalate",
                "unresolved"
              ]
            },
            "trace": {
              "$ref": "#/$defs/trace"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "idempotency",
            "onStale",
            "trace"
          ],
          "properties": {
            "op": {
              "const": "declarePersistence"
            },
            "idempotency": {
              "enum": [
                "durable",
                "session",
                "unresolved"
              ]
            },
            "onStale": {
              "enum": [
                "refuse",
                "escalate",
                "unresolved"
              ]
            },
            "trace": {
              "$ref": "#/$defs/trace"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "idempotency",
            "onSaveConflict",
            "trace"
          ],
          "properties": {
            "op": {
              "const": "declareDocument"
            },
            "idempotency": {
              "enum": [
                "durable",
                "session",
                "unresolved"
              ]
            },
            "trace": {
              "$ref": "#/$defs/trace"
            },
            "onSaveConflict": {
              "enum": [
                "refuse",
                "escalate",
                "unresolved"
              ]
            }
          }
        }
      ]
    },
    "effectFailureDisposition": {
      "enum": [
        "remain",
        "proceed",
        "unresolved"
      ]
    }
  }
}
