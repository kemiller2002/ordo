{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://echelonfoundry.dev/schemas/ordo-construction-plan.vocabulary-2.schema.json",
  "title": "Ordo construction plan v1 (vocabulary ordo.construction-vocabulary/2)",
  "description": "Structural validity only. Vocabulary 2 is vocabulary 1 plus a mandatory effect-failure disposition: every transitionEffect port declares onFailure (remain | proceed | unresolved), and a declareUnresolved may name the effect whose failure it leaves open. That an unresolved disposition has exactly one linked declareUnresolved, that a link names a declared effect whose disposition is unresolved, binding to a prepared ECIR cohort, trace consistency, workflow semantics and the canonical digest are enforced by Ordo ConstructionPlan.validate. A structurally valid plan grants no authority. The vocabulary deliberately has no member that can carry a file path, command, dependency, code or expression, architecture setting, policy change or handler.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "vocabularyVersion",
    "binding",
    "operations"
  ],
  "properties": {
    "schemaVersion": {
      "const": "ordo.construction-plan/1"
    },
    "vocabularyVersion": {
      "const": "ordo.construction-vocabulary/2"
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceManifestDigest",
        "blueprintDigest",
        "cohortId",
        "decisionIds"
      ],
      "properties": {
        "sourceManifestDigest": {
          "$ref": "#/$defs/digest"
        },
        "blueprintDigest": {
          "$ref": "#/$defs/digest"
        },
        "cohortId": {
          "$ref": "#/$defs/id"
        },
        "decisionIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          }
        }
      }
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/operation"
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "name": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[A-Za-z][A-Za-z0-9]*([ _-][A-Za-z0-9]+)*$"
    },
    "trace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requirementKeys",
        "nodeIds"
      ],
      "properties": {
        "requirementKeys": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "nodeIds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/id"
          }
        }
      }
    },
    "predicate": {
      "enum": [
        "extension"
      ]
    },
    "operation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "name",
            "trace"
          ],
          "properties": {
            "op": {
              "const": "defineWorkflow"
            },
            "name": {
              "$ref": "#/$defs/name"
            },
            "trace": {
              "$ref": "#/$defs/trace"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "name",
            "role",
            "trace"
          ],
          "properties": {
            "op": {
              "const": "defineState"
            },
            "name": {
              "$ref": "#/$defs/name"
            },
            "role": {
              "enum": [
                "initial",
                "ordinary",
                "terminal"
              ]
            },
            "trace": {
              "$ref": "#/$defs/trace"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "command",
            "from",
            "to",
            "guards",
            "trace"
          ],
          "properties": {
            "op": {
              "const": "defineTransition"
            },
            "command": {
              "$ref": "#/$defs/name"
            },
            "from": {
              "$ref": "#/$defs/name"
            },
            "to": {
              "$ref": "#/$defs/name"
            },
            "guards": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name",
                  "predicate"
                ],
                "properties": {
                  "name": {
                    "$ref": "#/$defs/name"
                  },
                  "predicate": {
                    "$ref": "#/$defs/predicate"
                  }
                }
              }
            },
            "trace": {
              "$ref": "#/$defs/trace"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "name",
            "predicate",
            "holdsIn",
            "trace"
          ],
          "properties": {
            "op": {
              "const": "defineInvariant"
            },
            "name": {
              "$ref": "#/$defs/name"
            },
            "predicate": {
              "$ref": "#/$defs/predicate"
            },
            "holdsIn": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/name"
              }
            },
            "trace": {
              "$ref": "#/$defs/trace"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "port",
            "trace"
          ],
          "properties": {
            "op": {
              "const": "declarePort"
            },
            "port": {
              "const": "currentTime"
            },
            "trace": {
              "$ref": "#/$defs/trace"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "port",
            "command",
            "onFailure",
            "trace"
          ],
          "properties": {
            "op": {
              "const": "declarePort"
            },
            "port": {
              "const": "transitionEffect"
            },
            "command": {
              "$ref": "#/$defs/name"
            },
            "onFailure": {
              "$ref": "#/$defs/effectFailureDisposition"
            },
            "trace": {
              "$ref": "#/$defs/trace"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "command",
            "capability",
            "trace"
          ],
          "properties": {
            "op": {
              "const": "bindCapability"
            },
            "command": {
              "$ref": "#/$defs/name"
            },
            "capability": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "trace": {
              "$ref": "#/$defs/trace"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "subject",
            "question",
            "trace"
          ],
          "properties": {
            "op": {
              "const": "declareUnresolved"
            },
            "subject": {
              "$ref": "#/$defs/name"
            },
            "effect": {
              "$ref": "#/$defs/name"
            },
            "question": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "trace": {
              "$ref": "#/$defs/trace"
            }
          }
        }
      ]
    },
    "effectFailureDisposition": {
      "enum": [
        "remain",
        "proceed",
        "unresolved"
      ]
    }
  }
}
