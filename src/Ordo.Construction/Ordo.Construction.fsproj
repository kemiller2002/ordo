<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <AssemblyName>Ordo.Construction</AssemblyName>
    <RootNamespace>Ordo.Construction</RootNamespace>
    <!--
      Published as an immutable release asset (`ordo-construction.nupkg`,
      checksummed in native-checksums.txt) beside ordo-core.nupkg, so hosts
      such as Praxis invoke construction by pinned version instead of copying
      the engine (CONSTRUCT-PACKAGE, GH-69). Its only dependency is
      EchelonFoundry.Ordo.Core at the same release version.
    -->
    <IsPackable>true</IsPackable>
    <PackageId>EchelonFoundry.Ordo.Construction</PackageId>
    <Authors>Echelon Foundry</Authors>
    <Description>Ordo's deterministic construction engine: a pure projection from a validated construction plan to immutable artifact descriptions, ownership-checked write plans and extension obligations. It writes no file and starts no process.</Description>
    <PackageLicenseExpression>PolyForm-Noncommercial-1.0.0</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/kemiller2002/ordo</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <!--
    The deterministic construction engine (CONSTRUCT-002 / GH-65). A pure
    projection from Ordo.Core's ValidatedPlan to immutable artifact
    descriptions and source text. It writes no file, starts no process and
    opens no connection; the host applies artifacts. Tests in
    Ordo.Construction.Tests assert that against this assembly's metadata.
    It references Ordo.Core only, and no package.
  -->
  <ItemGroup>
    <Compile Include="Naming.fs" />
    <Compile Include="Artifacts.fs" />
    <Compile Include="Emit.fs" />
    <Compile Include="Construction.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Ordo.Core/Ordo.Core.fsproj" />
  </ItemGroup>

</Project>
