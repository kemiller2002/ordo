<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <AssemblyName>Ordo.Core</AssemblyName>
    <RootNamespace>Ordo.Core</RootNamespace>
    <!--
      Ordo.Core is published as an immutable release artifact
      (`ordo-core.nupkg` on the Ordo GitHub release, checksummed in
      native-checksums.txt) so hosts such as Praxis consume Ordo's execution
      semantics by pinned version instead of copying them (ORDO-CORE-PACKAGE).
      The version is the repository's single release version.
    -->
    <IsPackable>true</IsPackable>
    <PackageId>EchelonFoundry.Ordo.Core</PackageId>
    <Authors>Echelon Foundry</Authors>
    <Description>Ordo's pure semantic core: execution roles and capabilities, mutation boundaries, evaluator identity, receipts, legal transitions and the ordo.execution-contract/1 reader.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/kemiller2002/ordo</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <!--
    Compile order is the dependency order, listed most primitive first, so a
    module can only use what is above it and a cycle cannot be written.

    Nothing in this project references a model-provider SDK, an HTTP client,
    a serializer framework, a logging framework, a DI container or ROS.
    `Ordo.Tests`' architecture tests assert that mechanically rather than
    trusting this comment.
  -->
  <ItemGroup>
    <Compile Include="Identifiers.fs" />
    <Compile Include="Json.fs" />
    <Compile Include="Clock.fs" />
    <Compile Include="Resolution.fs" />
    <Compile Include="Evidence.fs" />
    <Compile Include="Coverage.fs" />
    <Compile Include="NegativeKnowledge.fs" />
    <Compile Include="Capability.fs" />
    <Compile Include="Obligation.fs" />
    <Compile Include="ExternalEffect.fs" />
    <Compile Include="StateIdentity.fs" />
    <Compile Include="Policy.fs" />
    <Compile Include="Transition.fs" />
    <Compile Include="ExecutionRole.fs" />
    <Compile Include="Evaluator.fs" />
    <Compile Include="Receipt.fs" />
    <Compile Include="MutationBoundary.fs" />
    <Compile Include="BoundaryAmplification.fs" />
    <Compile Include="Authorization.fs" />
    <Compile Include="Execution.fs" />
    <Compile Include="Wire.fs" />
    <Compile Include="ExecutionWire.fs" />
    <Compile Include="BoundaryAmplificationWire.fs" />
    <Compile Include="ExecutionContract.fs" />
    <Compile Include="ConstructionIr.fs" />
  </ItemGroup>

</Project>
