<Project Sdk="Microsoft.NET.Sdk">

  <!--
    EXPERIMENTAL (VC-002). The constructed invoice slice. Files under
    generated/ are written by `construct` and must not be edited:
    generated/Invoice/*.g.fs by Ordo.Construction (unchanged engine),
    generated/Invoice.Authority.g.fs by the experiment's extension emitter.
    Everything else is handwritten extension code marked [<Authority(...)>].
    Dependencies: FSharp.Core only.
  -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Invoice.Slice</AssemblyName>
    <RootNamespace>Invoice.Slice</RootNamespace>
    <IsPackable>false</IsPackable>
    <Deterministic>true</Deterministic>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Provenance.fs" />
    <Compile Include="AssemblyInfo.fs" />
    <Compile Include="generated/Invoice/Invoice.Model.g.fs" />
    <Compile Include="generated/Invoice/Invoice.Transition.g.fs" />
    <Compile Include="generated/Invoice.Authority.g.fs" />
    <Compile Include="Money.fs" />
    <Compile Include="Payment.fs" />
    <Compile Include="Invoicing.fs" />
    <Compile Include="Persistence.fs" />
    <Compile Include="Probe.fs" />
  </ItemGroup>

</Project>
