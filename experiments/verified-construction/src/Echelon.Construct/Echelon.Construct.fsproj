<Project Sdk="Microsoft.NET.Sdk">

  <!--
    EXPERIMENTAL (VC-002). The `construct` entry point: authority handoff in,
    generated F# and construction trace out. Reuses Ordo.Core (ECIR, plan
    validation, classification) and Ordo.Construction (the F# emitter)
    unchanged, by project reference. Not part of any Ordo solution or CI path.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>construct</AssemblyName>
    <RootNamespace>Echelon.Construct</RootNamespace>
    <IsPackable>false</IsPackable>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Handoff.fs" />
    <Compile Include="Admission.fs" />
    <Compile Include="Translate.fs" />
    <Compile Include="AuthorityEmit.fs" />
    <Compile Include="Handwritten.fs" />
    <Compile Include="Trace.fs" />
    <Compile Include="Construct.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../../../src/Ordo.Core/Ordo.Core.fsproj" />
    <ProjectReference Include="../../../../src/Ordo.Construction/Ordo.Construction.fsproj" />
  </ItemGroup>

</Project>
