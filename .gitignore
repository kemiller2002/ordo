# Operating-system files
.DS_Store
Thumbs.db

# Editors
.vscode/
.idea/
*.swp

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Node
node_modules/

# SDE distribution build output (generated by the F# package builder,
# src/Sde.PackageBuilder; never an independent source of truth — see
# distribution/DISTRIBUTION-MAP.json)
distribution/dist/

# Per-platform executables staged by distribution/scripts/publish-runtimes.mjs.
# Build output, never committed: a release builds them from source in CI.
distribution/runtimes/

# .NET build output. Scoped to the F# project trees on purpose: a bare `bin/`
# would also ignore distribution/bin/, which holds the published Node launcher.
src/**/bin/
src/**/obj/
tests/**/bin/
tests/**/obj/
*.tgz

# Generated transient work
work/staging/*
work/review/*
logs/*

# Preserve directory markers and documentation
!work/staging/.gitkeep
!work/review/.gitkeep
!logs/.gitkeep

# Secrets
.env
.env.*
!.env.example
*.pem
*.key
